{
  "version": 8,
  "name": "Sumbar Terang PMTiles (Vector)",
  "metadata": {
    "theme": "light",
    "type": "pmtiles"
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///tiles/sumbar-basemap.pmtiles"
    },
    "terrain-dem": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "encoding": "terrarium",
      "maxzoom": 15
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#FAFAF8"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#2C6E8C"
      }
    },
    {
      "id": "landuse-vegetation",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#E8F4EC"
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#1E3A5F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 5]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 13
      },
      "paint": {
        "text-color": "#1F2937",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    }
  ]
}
